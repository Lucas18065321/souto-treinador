# Modelo do arquivo de chaves. Copie para .env (Copy-Item .env.example .env) e cole cada chave depois do "=" (sem aspas).
# O .env NUNCA sobe para o GitHub (.gitignore). Cada frente acrescenta aqui as variáveis que usa.
# Chaves do Supabase e da Edison NÃO ficam aqui: ficam em %USERPROFILE%\SoutoTreinador\privado\ e %USERPROFILE%\.edison-key.

# ===== Bancos de imagens e vídeos grátis (carrossel e vídeo, via stock.mjs) =====
# Pexels (vídeos e fotos): https://www.pexels.com/api/ → "Get Started" → a chave aparece em "Your API Key"
PEXELS_API_KEY=
# Pixabay (vídeos, fotos, ilustrações): https://pixabay.com/api/docs/ → logado, a chave aparece na seção "Parameters" (key)
PIXABAY_API_KEY=
# Openverse (imagens de domínio público/CC) NÃO precisa de chave.

# ===== 04 - EDIÇÃO DE VÍDEO =====
# Pasta dos projetos de vídeo, brutos, renders, B-roll, músicas e modelos do Whisper. FORA do repositório e do OneDrive.
# Vazio = %USERPROFILE%\Videos\Souto-Projetos
SOUTO_VIDEO_PROJETOS=
# Opcional, NÃO recomendado (gera custo): Google AI Studio → https://aistudio.google.com/apikey . Só para o scripts/gen.mjs (emergência).
GEMINI_API_KEY=
# Teto de gasto do gen.mjs em dólares (o script se recusa a passar disso)
GEMINI_BUDGET_USD=5
# Opcional: voz de referência para o estúdio de áudio (uma gravação sua que você aprovou), caminho completo .wav/.mp4
SOUTO_VOZ_REFERENCIA=

# ===== 06 · Gestão da consultoria (Painel ST, agente de dieta) =====
# NÃO preencha aqui. Estas chaves ficam num arquivo FORA do repositório:
#   %USERPROFILE%\SoutoTreinador\privado\supabase.env
# (passo a passo em docs/guias/05-dieta-e-painel-st.md). Este bloco só mostra o formato.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=entregas
# opcional: SHA-256 do PIN do RT (o painel pede o PIN para "Aprovar como RT")
RT_PIN_HASH=
# opcionais (caminhos fora do repositório):
# ST_PRIVADO=%USERPROFILE%\SoutoTreinador\privado
# ST_ALUNOS=%USERPROFILE%\SoutoTreinador\Alunos
# ST_ASSINATURA_RT=%USERPROFILE%\SoutoTreinador\privado\assinatura-rt.png
# CHROME=C:\Program Files\Google\Chrome\Application\chrome.exe
# Segredo do webhook do Tally: vai nos "Secrets" da Edge Function no Supabase (TALLY_SIGNING_SECRET), não no PC.
