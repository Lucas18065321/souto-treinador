motor/node_modules/.cache/
motor/gen-ledger.json
motor/src/.props-*.json
**/.props-render-*.json
**/.props-ilha.json

# Modelos e ferramentas baixados (o instalar-video.ps1 baixa e confere o sha256)
*.bin
deep-filter*.exe

# SFX: só vão os livres (Glitch Noises CC0 + sintetizados). Mixkit e 99Sounds proíbem redistribuir:
# cada um baixa os seus (guia 04-video, seção SFX). A pasta motionix/ é gerada pelo instalador.
sfx/biblioteca/motionix/
sfx/lab/*/*.wav
!sfx/lab/*/*_gn-*.wav
!sfx/lab/papel/papel_0[1-6]_pestana-*.wav
sfx/lab/previas/
sfx/lab/medidas.tsv
sfx/lab/medidas.json

